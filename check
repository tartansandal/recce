#!/bin/sh
#
# Lint, format-check and test the tree on both interpreters that matter.
#
# Two are needed, and the reason is a bug this script exists because of.
# `.python-version` pins the dev venv to 3.9, the compatibility floor, so
# `uv run pytest` only ever exercises that. But recce parses source with the
# interpreter it runs on, and that interpreter is whatever the user has —
# `ast.Ellipsis` was deprecated in 3.8 and *removed* in 3.12, so a reference to
# it passed every test on 3.9 and crashed on 3.14 the moment someone pointed
# recce at a codebase using `Callable[..., X]`.
#
# The floor catches syntax and library use that is too new. The ceiling catches
# ast API that has since been removed. Neither run is redundant.
#
# `--isolated` matters on the ceiling run: without it `uv run --python 3.14`
# rebuilds .venv on 3.14 and leaves it there, so every later floor run silently
# tests the wrong thing.

set -e

root="$(cd "$(dirname "$0")" && pwd)"
cd "$root"

echo '== ruff =='
uv run ruff check .
uv run ruff format --check .

echo '== pytest on the 3.9 floor =='
uv run pytest -q

# Newest interpreter uv can find. Update as new releases land; the point is to
# run on something well past 3.12, not on this exact version.
ceiling="${RECCE_CEILING:-3.14}"
echo "== pytest on $ceiling =="
uv run --isolated --python "$ceiling" --with pytest pytest -q
